# Copie para .env e preencha. NUNCA suba o arquivo .env para o Git.
# Estes valores são segredos do SERVIDOR. Cadastre com `supabase secrets set NOME=valor`.
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem automaticamente nas Edge Functions.)

# Mercado Pago (docs/PAGAMENTO.md)
MP_ACCESS_TOKEN=
MP_PAYER_EMAIL=loja@seudominio.com

# Endereço do site, para liberar só ele nas funções (CORS). Ex.: https://juntodoces.netlify.app
ALLOWED_ORIGIN=

# WhatsApp Cloud API, opcional (docs/WHATSAPP.md)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_STATUS=
